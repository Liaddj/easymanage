# Copy to `.env` at the repo root. Never commit `.env` or real secrets.
# Placeholders only — fill locally. Do not invent production credentials.

NODE_ENV=development
PORT=3000

# Product timezone is locked to Israel for v1.
APP_TIMEZONE=Asia/Jerusalem

# Local Postgres (see docker-compose.yml). Replace for real environments.
DATABASE_URL=postgres://flow:flow@localhost:5432/flow

# Google Calendar OAuth (provider → Flow, one-way). Leave empty until calendar work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/google/callback

# Feature flags (`true` / `false`)
FEATURE_GOOGLE_CALENDAR_SYNC=false

# Mobile → API (dev). No payment or PSP keys belong here — v1 has no payment surface.
EXPO_PUBLIC_API_URL=http://localhost:3000
