{
  "name": "flow",
  "version": "1.0.0",
  "private": true,
  "description": "Flow — dual-sided booking for solo fitness and tennis coaches (Israel)",
  "type": "module",
  "scripts": {
    "dev": "GATE_DISABLED=1 concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "GATE_DISABLED=1 node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test:api": "node server/api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
